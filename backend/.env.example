# Backend database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irms_db
DB_USERNAME=irms_user
DB_PASSWORD=irms_pass

# Backend server
SERVER_PORT=3000

# Backend security
JWT_SECRET=change-this-secret-key-in-production-minimum-256-bits-required

# Flyway local behavior (DB already created manually in pgAdmin)
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
